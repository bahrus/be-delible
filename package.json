{
  "name": "be-delible",
  "version": "0.0.19",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements"
  ],
  "description": "Make a DOM element delible",
  "main": "be-delible.js",
  "module": "be-delible.js",
  "exports": {
    ".": "./delible.js",
    "./be-delible.js": "./be-delible.js",
    "./emc.js": "./emc.js",
    "./⌫.js": "./⌫.js"
  },
  "files": [
    "*.js",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "scripts": {
    "build": "node emc.mjs > emc.json && node ⌫.mjs > ⌫.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-hive": "0.1.15",
    "mount-observer": "0.1.41",
    "roundabout-lib": "0.0.21"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "spa-ssi": "0.0.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-delible.git"
  },
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-delible/issues"
  },
  "homepage": "https://github.com/bahrus/be-delible#readme"
}
